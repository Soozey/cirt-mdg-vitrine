VITE_FIREBASE_API_KEY=REPLACE_ME_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_ME_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_ME_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME_SENDER_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com

# Set to true when running Firebase Emulator Suite locally.
VITE_USE_FIREBASE_EMULATOR=true

# Required by server-side Firebase Admin when VITE_USE_FIREBASE_EMULATOR=false
# and you run the app locally. Use one of these credential methods:
FIREBASE_PROJECT_ID=REPLACE_ME_PROJECT_ID
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"REPLACE_ME_PROJECT_ID",...}
GOOGLE_APPLICATION_CREDENTIALS=/xxx/xx/xxxxx.json

# Docker Compose bind mount source for the Firebase Admin SDK JSON file.
# On a VPS, set this to the real host path where the JSON file exists.
FIREBASE_ADMINSDK_FILE=./service-account.json
